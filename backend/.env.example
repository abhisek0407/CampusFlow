# --- Required ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orchestrai_db?retryWrites=true&w=majority
JWT_SECRET=change-me-long-random-string
AGENT_SHARED_SECRET=change-me-same-on-backend-and-agent

# --- Production (Render): solver runs as its own service ---
# Leave AI_SERVICE_URL empty locally and the backend spawns python itself (old behaviour).
AI_SERVICE_URL=https://campusflow-ai-service.onrender.com
AI_SERVICE_SECRET=change-me-same-on-ai-service
AGENT_URL=https://campusflow-agent.onrender.com
